# local: no request is allowed to leave the Forum Node by default.
# connected: explicit Network services may be configured.
FORUM_DEPLOYMENT_MODE=local
FORUM_DATA_SOURCE=seed

# Development only: enables the explicit request-scoped identity picker at
# /session. It is ignored in production and in connected mode.
FORUM_ENABLE_DEV_ACTOR=true

# Required when FORUM_DATA_SOURCE=postgres.
DATABASE_URL=

# Optional AI provider. Leave blank in local mode until a local endpoint exists.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
