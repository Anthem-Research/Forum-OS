<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forum_parent_paper"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_variable"
        android:text="@string/change_pin"
        android:textColor="@color/forum_ink"
        android:textFontWeight="300"
        android:textSize="30sp" />

    <EditText
        android:id="@+id/new_pin"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:autofillHints="newPassword"
        android:fontFamily="@font/inter_variable"
        android:hint="@string/new_pin"
        android:importantForAutofill="yes"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textColor="@color/forum_ink"
        android:textColorHint="@color/forum_muted" />

    <EditText
        android:id="@+id/confirm_pin"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:autofillHints="newPassword"
        android:fontFamily="@font/inter_variable"
        android:hint="@string/confirm_pin"
        android:importantForAutofill="yes"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textColor="@color/forum_ink"
        android:textColorHint="@color/forum_muted" />

    <TextView
        android:id="@+id/pin_change_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/forum_orange"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/save_pin"
        style="@style/ForumParentAction"
        android:layout_marginTop="12dp"
        android:text="@string/save_pin" />
</LinearLayout>

