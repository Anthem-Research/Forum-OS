<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forum_ink"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_variable"
        android:letterSpacing="0.28"
        android:text="@string/parent"
        android:textColor="@color/forum_paper"
        android:textFontWeight="500"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/gate_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/inter_variable"
        android:letterSpacing="0.28"
        android:text="@string/enter_pin"
        android:textColor="#B9C0BB"
        android:textFontWeight="500"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <View android:id="@+id/pin_dot_1" android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/pin_dot_2" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="20dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/pin_dot_3" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="20dp" android:background="@drawable/pin_dot_empty" />
        <View android:id="@+id/pin_dot_4" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="20dp" android:background="@drawable/pin_dot_empty" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/pin_keypad"
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/key_1" style="@style/PinKey" android:text="1" />
        <Button android:id="@+id/key_2" style="@style/PinKey" android:text="2" />
        <Button android:id="@+id/key_3" style="@style/PinKey" android:text="3" />
        <Button android:id="@+id/key_4" style="@style/PinKey" android:text="4" />
        <Button android:id="@+id/key_5" style="@style/PinKey" android:text="5" />
        <Button android:id="@+id/key_6" style="@style/PinKey" android:text="6" />
        <Button android:id="@+id/key_7" style="@style/PinKey" android:text="7" />
        <Button android:id="@+id/key_8" style="@style/PinKey" android:text="8" />
        <Button android:id="@+id/key_9" style="@style/PinKey" android:text="9" />
        <Button android:id="@+id/key_delete" style="@style/PinKeySmall" android:text="@string/delete" />
        <Button android:id="@+id/key_0" style="@style/PinKey" android:text="0" />
        <Space android:layout_width="88dp" android:layout_height="70dp" />
    </GridLayout>

    <Button
        android:id="@+id/gate_cancel"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/inter_variable"
        android:letterSpacing="0.24"
        android:text="@string/cancel"
        android:textColor="#B9C0BB"
        android:textFontWeight="500"
        android:textSize="11sp" />
</LinearLayout>

