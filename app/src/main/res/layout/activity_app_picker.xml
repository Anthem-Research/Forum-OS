<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forum_parent_paper"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="40dp"
    android:paddingEnd="56dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/forum_ink"
        android:textFontWeight="300"
        android:textSize="30sp" />

    <Button
        android:id="@+id/clear_assignment"
        style="@style/ForumParentAction"
        android:layout_marginTop="12dp"
        android:text="@string/clear_assignment" />

    <ListView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="@drawable/parent_divider"
        android:dividerHeight="1dp" />
</LinearLayout>

