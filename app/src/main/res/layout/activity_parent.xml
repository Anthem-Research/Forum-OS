<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forum_parent_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="52dp"
        android:paddingEnd="72dp"
        android:paddingBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:letterSpacing="0.24"
                    android:text="@string/forum_wordmark"
                    android:textColor="@color/forum_orange"
                    android:textFontWeight="500"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/parent_controls"
                    android:textColor="@color/forum_ink"
                    android:textFontWeight="300"
                    android:textSize="38sp" />
            </LinearLayout>

            <Button
                android:id="@+id/lock_forum"
                style="@style/ForumParentAction"
                android:text="@string/lock_forum" />
        </LinearLayout>

        <TextView
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/inter_variable"
            android:text="@string/parent_intro"
            android:textColor="@color/forum_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/policy_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/forum_muted"
            android:textFontWeight="500"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:divider="@drawable/parent_divider"
            android:orientation="vertical"
            android:showDividers="beginning|middle|end">

            <include layout="@layout/row_assignment_ask" />
            <include layout="@layout/row_assignment_draw" />
            <include layout="@layout/row_assignment_look" />
            <include layout="@layout/row_assignment_synthesis" />
            <include layout="@layout/row_assignment_play" />
        </LinearLayout>

        <Switch
            android:id="@+id/sealed_mode"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter_variable"
            android:text="@string/sealed_mode"
            android:textColor="@color/forum_ink"
            android:textFontWeight="500"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:text="@string/sealed_mode_summary"
            android:textColor="@color/forum_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/change_pin" style="@style/ForumParentAction" android:text="@string/change_pin" />
            <Button android:id="@+id/request_home" style="@style/ForumParentAction" android:layout_marginStart="24dp" android:text="@string/request_home_role" />
            <Button android:id="@+id/enable_admin" style="@style/ForumParentAction" android:layout_marginStart="24dp" android:text="@string/enable_admin" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/open_settings" style="@style/ForumParentAction" android:text="@string/android_settings" />
            <Button android:id="@+id/maintenance_exit" style="@style/ForumParentAction" android:layout_marginStart="24dp" android:text="@string/maintenance_exit" />
            <Button android:id="@+id/relock_device" style="@style/ForumParentAction" android:layout_marginStart="24dp" android:text="@string/relock_device" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

